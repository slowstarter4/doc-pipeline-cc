{
  "endpoints": [
    {
      "method": "POST",
      "path": "/widgets",
      "summary": "위젯 등록",
      "request": {"name": "string", "quantity": "number"},
      "response": {"id": "number", "name": "string", "quantity": "number"},
      "rules": ["name이 없으면 400", "quantity가 음수면 400"]
    },
    {
      "method": "GET",
      "path": "/widgets",
      "summary": "위젯 목록 조회",
      "response": {"widgets": [{"id": "number", "name": "string", "quantity": "number"}]},
      "rules": []
    },
    {
      "method": "PUT",
      "path": "/widgets/{id}",
      "summary": "위젯 수량 변경",
      "request": {"quantity": "number"},
      "response": {"id": "number", "name": "string", "quantity": "number"},
      "rules": ["존재하지 않는 id면 404"]
    }
  ],
  "happyPath": {
    "seed": [],
    "steps": [
      {"name": "필수값 누락 -> 거부", "method": "POST", "path": "/widgets",
       "body": {"name": "", "quantity": 1}, "expect": 400},

      {"name": "위젯 등록 성공", "method": "POST", "path": "/widgets",
       "body": {"name": "verify-widget", "quantity": 5},
       "expect": 201, "capture": {"widgetId": "id", "__persist": "id"}},

      {"name": "목록에 반영 확인", "method": "GET", "path": "/widgets",
       "expect": 200, "expectAnyItem": {"name": "verify-widget", "quantity": 5}},

      {"name": "수량 변경", "method": "PUT", "path": "/widgets/${widgetId}",
       "body": {"quantity": 9}, "expect": [200, 201]},

      {"name": "존재하지 않는 id 수정 시도 -> 404", "method": "PUT", "path": "/widgets/999999",
       "body": {"quantity": 1}, "expect": 404}
    ]
  }
}
